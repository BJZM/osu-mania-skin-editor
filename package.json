{
  "name": "osu-mania-skin-editor",
  "version": "0.3.2",
  "private": true,
  "description": "Visual editor and previewer for osu!stable mania skins",
  "author": "BJZM",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "build:icon": "electron tools/build-icon.cjs",
    "build:css": "node tools/build-css.mjs",
    "build:html": "node tools/build-html.mjs",
    "build:site": "npm run build:css && npm run build:html && node tools/build-site.mjs",
    "check:css": "node tools/build-css.mjs --check",
    "audit:css": "node tools/audit-css.mjs",
    "check:html": "node tools/build-html.mjs --check",
    "serve": "npm run build:css && npm run build:html && node tools/static-server.cjs",
    "check": "node tools/check-js.mjs && npm run check:css && npm run audit:css && npm run check:html",
    "test:e2e": "npm run build:css && npm run build:html && playwright test",
    "test": "npm run check && npm run test:e2e",
    "desktop": "npm run build:css && npm run build:html && electron .",
    "dist:win": "node tools/build-exe.mjs",
    "deploy:pages": "npm run build:site && node tools/deploy-pages.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@electron/asar": "3.4.1",
    "@electron/get": "5.1.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "extract-zip": "2.0.1"
  },
  "build": {
    "appId": "com.osumania.skineditor",
    "productName": "osu-mania-skin-editor",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "index.html",
      "src/**/*",
      "vendor/**/*",
      "assets/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "osu-mania-skin-editor-${version}-${arch}.${ext}"
    }
  }
}
